{
  "name": "sub-morph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build && wrangler dev --local-upstream localhost:8787",
    "dev:web": "vite",
    "build": "node scripts/copy-wasm.mjs && vite build",
    "typecheck": "node scripts/copy-wasm.mjs && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "node scripts/kumo-lint.mjs",
    "test": "node scripts/kumo-lint.mjs && node --experimental-strip-types --no-warnings test/run-tests.ts",
    "db:migrate:local": "wrangler d1 migrations apply sub-morph-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sub-morph-db --remote",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:inline": "pnpm build && node scripts/build-inline-assets.mjs && wrangler deploy -c wrangler.inline.jsonc",
    "wasm": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@phosphor-icons/react": "^2.1.10",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
